{
  "manifest_version": 3,
  "name": "Slip Catch Practice",
  "version": "1.0.0",
  "description": "A quick cricket slip-catching game for your break. Click the toolbar icon to play in a tab.",
  "action": {
    "default_title": "Play Slip Catch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
