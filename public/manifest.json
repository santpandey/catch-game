{
  "manifest_version": 3,
  "name": "Slip Catch Practice",
  "version": "1.1.0",
  "description": "Practice cricket slip catches in a floodlit 3D stadium. Quick fun for your break.",
  "action": {
    "default_title": "Play Slip Catch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
